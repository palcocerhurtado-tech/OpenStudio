# ADV ARCHON — configuración en ~/.adv-archon/.env
# Copia este archivo a ~/.adv-archon/.env y rellena los valores

# ── Motor LLM ──────────────────────────────────────────────
# Modo por defecto: local (Ollama) o cloud (Gemini)
ADV_ARCHON_DEFAULT_MODE=local
ADV_ARCHON_DEFAULT_OLLAMA_MODEL=llama3.1:8b

# ── Gemini (modo cloud) ────────────────────────────────────
# Obtén tu clave en: aistudio.google.com
# GEMINI_API_KEY=AIzaSy...

# ── Notion ────────────────────────────────────────────────
# Obtén tu token en: notion.so/my-integrations
# NOTION_TOKEN=secret_xxxx

# ── Obsidian ──────────────────────────────────────────────
# Ruta a tu vault local de Obsidian
# OBSIDIAN_VAULT_PATH=~/Documents/ObsidianVault

# ── Gmail ─────────────────────────────────────────────────
# Genera una App Password en: myaccount.google.com → Security → App passwords
# GMAIL_ADDRESS=tu@gmail.com
# GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx
