# OpenStudio — Environment Variables
# Copy this file to .env and fill in your keys
# Every key is optional except MUAPI_KEY for generative models

# ─── CORE ────────────────────────────────────────────────────────────────────
# Muapi.ai — unified gateway for 200+ image/video/lipsync models
# Free tier available at https://muapi.ai
MUAPI_KEY=

# ─── IMAGE & VIDEO GENERATION ────────────────────────────────────────────────
# fal.ai — FLUX images + Google Veo, Kling, MiniMax video + Recraft images
FAL_KEY=

# Runway Gen-4 direct
RUNWAY_API_KEY=

# HeyGen — multi-model video gateway (Veo, Sora, Runway, Kling)
HEYGEN_API_KEY=

# ─── VOICE & AUDIO ───────────────────────────────────────────────────────────
# ElevenLabs — premium TTS, AI music, sound effects
ELEVENLABS_API_KEY=

# OpenAI — TTS, DALL-E 3 images
OPENAI_API_KEY=

# Google — 700+ TTS voices, Imagen images
GOOGLE_API_KEY=

# ─── MUSIC ───────────────────────────────────────────────────────────────────
# Suno AI — full song generation with vocals, any genre, up to 8 min
SUNO_API_KEY=

# ─── FREE STOCK MEDIA ────────────────────────────────────────────────────────
# Both are free to sign up — unlock stock footage and images
PEXELS_API_KEY=
PIXABAY_API_KEY=

# ─── LOCAL GPU (optional) ────────────────────────────────────────────────────
# Enable free local video generation (requires GPU + make install-gpu)
VIDEO_GEN_LOCAL_ENABLED=false
# Options: wan2.1-1.3b, wan2.1-14b, hunyuan-1.5, ltx2-local, cogvideo-5b
VIDEO_GEN_LOCAL_MODEL=wan2.1-1.3b

# ─── BUDGET GOVERNANCE ───────────────────────────────────────────────────────
# Mode: observe (track only) | warn (log overruns) | cap (hard stop)
BUDGET_MODE=warn
# Hard cap in USD (default $10)
BUDGET_CAP_USD=10.00
# Pause for approval above this per-action cost
BUDGET_APPROVAL_THRESHOLD_USD=0.50
